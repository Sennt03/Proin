<section id="contact">
      <div class="container">
        <h2 class="section-title reveal">Contáctanos</h2>
        <p class="section-subtitle reveal">Estamos listos para ayudarte en tu próximo proyecto.</p>

        <div class="contact-wrap reveal"
        >
          <form class="form" target="_blank" action="https://formsubmit.co/asesora1proin@gmail.com" method="POST">
            <input type="hidden" name="_subject" value="Mensaje web">
            <input type="hidden" name="_captcha" value="false">
            <input type="hidden" name="_template" value="table">

            <h3 style="margin-bottom:12px">Envíanos un mensaje</h3>
            <div class="row">
              <div>
                <label for="name">Nombre completo</label>
                <input name="nombre" id="name" placeholder="Tu nombre" required />
              </div>
              <div>
                <label for="phone">Teléfono</label>
                <input name="telefono" id="phone" placeholder="+593 982868135" />
              </div>
            </div>

            <div style="margin-top:12px">
              <label for="email">Correo electrónico</label>
              <input name="email" id="email" type="email" placeholder="tu.correo@ejemplo.com" required />
            </div>

            <div style="margin-top:12px">
              <label for="msg">Mensaje</label>
              <textarea name="mensaje" id="msg" rows="5" placeholder="Escribe tu mensaje..." required></textarea>
            </div>

            <div style="margin-top:14px"><button class="btn-submit" type="submit">Enviar Mensaje</button></div>
          </form>

          <aside class="info"
          style="justify-content: center;display: flex;flex-direction: column;align-items: center;">
            <h3
            style="font-size: 25px;margin-bottom: 15px;">Datos de contacto</h3>
            <p style="color:var(--muted);margin-bottom:10px"><a href="https://wa.me/593982868135" target="_blank">Tel: +593 982868135</a></p>
            <p style="color:var(--muted);margin-bottom:10px"><a href="mailto:asesora1proin@gmail.com">Email: asesora1proin@gmail.com</a></p>

            <img style="margin: 0 auto; max-width: 200px;" src="/assets/images/logo.jpg" alt="proin logo">
          </aside>
        </div>

      </div>
    </section>
