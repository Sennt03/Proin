---
import Productos from '../../layouts/Products.astro';
---

<Productos categoria="Tuberías" css="4" texto="Tuberías acero al carbono, acero inoxidable, sanitario y acero galvanizado">
  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img
        src="/assets/images/tub-carbon.jpg"
        alt="Tuberia Acero al Carbon"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="product-body">
      <h4 class="product-title">Acero al Carbono</h4>
    </div>
  </article>

  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img src="/assets/images/tub_inox.png" alt="Tuberia Acero Inoxidable" loading="lazy" decoding="async" />
    </figure>
    <div class="product-body"><h4 class="product-title">Acero Inoxidable</h4></div>
  </article>

  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img
        src="/assets/images/tubo-galvanizado.jpg"
        alt="Tubo Galvanizado ISO II"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="product-body"><h4 class="product-title">Tubo Galvanizado ISO II</h4></div>
  </article>

  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img
        src="/assets/images/galvanizado-astm.jpg"
        alt="Tubo Galvanizado ASTM"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="product-body"><h4 class="product-title">Tubo Galvanizado ASTM</h4></div>
  </article>

  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img src="/assets/images/inox-sanitario.jpg" alt="Tuberia inox sanitario" loading="lazy" decoding="async" />
    </figure>
    <div class="product-body"><h4 class="product-title">INOX Sanitario</h4></div>
  </article>
</Productos>
