---
import Productos from '../../layouts/Products.astro';
---

<Productos categoria="Válvulas" css="4" texto="Accesorios y bridas acero al carbon, acero forjado, hierro maleable, INOX y sanitario">
  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img src="/assets/images/accesorio_carbono.png" alt="Bridas acero al carbon" loading="lazy" decoding="async" />
    </figure>
    <div class="product-body">
      <h4 class="product-title">Acero al Carbon</h4>
    </div>
  </article>

  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img src="/assets/images/accs_inox.png" alt="Bridas Acero Inoxidable" loading="lazy" decoding="async" />
    </figure>
    <div class="product-body"><h4 class="product-title">Acero Inoxidable</h4></div>
  </article>

  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img src="/assets/images/accesorio_inox.png" alt="Bridas Acero Forjado" loading="lazy" decoding="async" />
    </figure>
    <div class="product-body"><h4 class="product-title">Acero Forjado</h4></div>
  </article>

  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img
        src="/assets/images/bridas-galvanizado.jpg"
        alt="Bridas Hierro Negro y Galvanizado"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="product-body"><h4 class="product-title">Hierro Negro y Galvanizado</h4></div>
  </article>

  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img
        src="/assets/images/bridas-sanitario.jpeg"
        alt="Bridas Acero Inoxidable Sanitario"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="product-body"><h4 class="product-title">INOX Sanitario</h4></div>
  </article>

  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img
        src="/assets/images/bridas.jpg"
        alt="Bridas"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="product-body"><h4 class="product-title">Bridas</h4></div>
  </article>

  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img
        src="/assets/images/empaques-espirometalicos.jpg"
        alt="Empaques Espirometalicos - Bridas"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="product-body"><h4 class="product-title">Empaques Espirometálicos</h4></div>
  </article>

  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img
        src="/assets/images/esparragos.png"
        alt="Bridas - Esparragos"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="product-body"><h4 class="product-title">Esparragos</h4></div>
  </article>
</Productos>
