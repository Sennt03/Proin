---
import Productos from '../../layouts/Products.astro';
---

<Productos categoria="Otros" css="4" texto="Manómetros, Neplos, Colas de Chancho, Perfilería y Mecanizados">
  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img
        src="/assets/images/manometros.jpg"
        alt="Manómetros"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="product-body">
      <h4 class="product-title">Manómetros</h4>
    </div>
  </article>

  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img src="/assets/images/neplos.jpg" alt="Neplos" loading="lazy" decoding="async" />
    </figure>
    <div class="product-body"><h4 class="product-title">Neplos</h4></div>
  </article>

  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img
        src="/assets/images/cola-chancho.jpg"
        alt="Colas de Chancho"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="product-body"><h4 class="product-title">Colas de Chancho</h4></div>
  </article>

  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img
        src="/assets/images/perfileria.jpg"
        alt="Perfileria"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="product-body"><h4 class="product-title">Perfilería</h4></div>
  </article>

  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img src="/assets/images/mecanizados.jpg" alt="Mecanizados" loading="lazy" decoding="async" />
    </figure>
    <div class="product-body"><h4 class="product-title">Mecanizados</h4></div>
  </article>
</Productos>
