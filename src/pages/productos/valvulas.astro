---
import Productos from '../../layouts/Products.astro';
---

<Productos categoria="Válvulas" css="4" texto="Válvulas acero al carbón, acero inoxidable, bronce y sanitario">
  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img src="/assets/images/bridadas.png" alt="Bridas | Bridadas | INOX" loading="lazy" decoding="async" />
    </figure>
    <div class="product-body">
      <h4 class="product-title">Bridadas</h4>
    </div>
  </article>

  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img
        src="/assets/images/roscadas.jpg"
        alt="Roscadas | Soldar | INOX"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="product-body"><h4 class="product-title">Roscadas / Soldar</h4></div>
  </article>

  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img
        src="/assets/images/soldar.jpg"
        alt="Valvulas Sanitarias | Clamp | Soldar"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="product-body"><h4 class="product-title">Sanitarias / Clamp / Soldar</h4></div>
  </article>

  <article class="product-card" role="listitem" data-cat="accesorios" tabindex="0">
    <figure class="product-media">
      <img src="/assets/images/filtros.jpg" alt="Valvulas - Filtros" loading="lazy" decoding="async" />
    </figure>
    <div class="product-body"><h4 class="product-title">Filtros</h4></div>
  </article>
</Productos>
